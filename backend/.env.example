APP_NAME=Classroom Vision System
APP_ENV=dev
HOST=127.0.0.1
PORT=8000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=classroom_vision

UPLOAD_DIR=app/static/uploads
RESULT_DIR=app/static/results
MODEL_PATH=weights/scb_yolo.pt

# true：没有训练权重时返回模拟分析结果，方便前后端联调
# false：必须存在 MODEL_PATH 并调用 YOLO 推理
MOCK_ANALYSIS=true

# 视频抽帧间隔，单位秒
FRAME_INTERVAL_SECONDS=2
CONF_THRESHOLD=0.25
